{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "react", "react-dom"],
    "rootDir": "..",
    "tsBuildInfoFile": "./.tsbuildinfo.client",
    "paths": {
      "@hatch/space-sdk": ["../vendor/space-sdk/src/index.ts"],
      "@hatch/space-sdk/client": ["../vendor/space-sdk/src/client.tsx"],
      "@hatch/space-sdk/*": ["../vendor/space-sdk/src/*"]
    }
  },
  "include": ["src/**/*", "../server/src/actions.ts", "../server/src/schema.ts", "../vendor/space-sdk/src/**/*"]
}
